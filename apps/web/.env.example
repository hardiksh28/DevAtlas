# For local `pnpm --filter web dev` on the host (not Docker), copy this to
# apps/web/.env.local — Next.js only reads env files from the app's own
# directory, not the repo root. When running via docker-compose instead,
# this value comes from the root .env file via the `web` service's
# environment block.
NEXT_PUBLIC_API_URL=http://localhost:8000
