# For running the API directly on the host (uv run uvicorn ...) instead of
# via docker-compose. Copy to apps/api/.env. Note the "localhost" hosts
# below — inside Docker Compose these would be service names (postgres,
# redis, ollama) instead; see the root .env.example for that version.
# pydantic-settings resolves .env relative to the process's working
# directory, which is apps/api when you run `uv run` from here — a
# repo-root .env is NOT picked up automatically.

API_SECRET_KEY=local-dev-secret
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://devatlas:change-me-locally@localhost:5432/devatlas
REDIS_URL=redis://localhost:6379/0

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=ollama

NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Documentation Ingestion Engine ---
# "local" writes to disk under OBJECT_STORAGE_LOCAL_PATH — no MinIO/S3
# needed for host-only dev. Switch to "s3" + OBJECT_STORAGE_ENDPOINT_URL=
# http://localhost:9000 if you're running docker-compose's `minio`
# service alongside a host-run API (see root .env.example for the
# in-container equivalent, which always uses "s3").
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=./.data/object_storage
# GITHUB_API_TOKEN=

# --- RAG Knowledge Engine (docs/architecture/rag-engine-v1.md) ---
# All have working defaults (see app/core/config.py) — only set them
# here to deviate.
# RETRIEVAL_TOP_K=8
# CONTEXT_MAX_TOKENS=3000
# RETRIEVAL_CACHE_TTL_SECONDS=300

# --- Taxonomy & Curriculum Engine (docs/architecture/curriculum-engine-v1.md) ---
# All have working defaults (see app/core/config.py) — only set them
# here to deviate. Default TAXONOMY_DATA_DIR assumes scripts/seed_taxonomy.py
# is run from apps/api (uv run's default working directory).
# TAXONOMY_DATA_DIR=../../packages/taxonomy-data/concepts
# CURRICULUM_MINUTES_FOUNDATIONAL=30
# CURRICULUM_MINUTES_INTERMEDIATE=60
# CURRICULUM_MINUTES_ADVANCED=90

# --- Mentoring Engine (docs/architecture/mentor-engine-v1.md) ---
# MENTOR_RECENT_MESSAGE_LIMIT=20
# MENTOR_SUMMARY_TRIGGER_MESSAGES=20
