# Copy this file to .env and fill in real values. .env is gitignored.
# docker-compose and the apps both read from this file.

# --- Postgres ---
POSTGRES_USER=aiengineering
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ai_engineering
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aiengineering:change-me-locally@postgres:5432/ai_engineering

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Ollama (local LLM provider) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# --- LLM Gateway ---
# "ollama" for local dev. The gateway is provider-swappable; a future
# "anthropic" provider can be added here without changing callers.
LLM_PROVIDER=ollama

# --- Auth (GitHub OAuth + GitHub App) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Auth (email/password) ---
# All of these have working defaults (see app/core/config.py) — only set
# them here if you need to deviate. FRONTEND_URL is what password-reset
# and email-verification links point to.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# MAX_FAILED_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15
FRONTEND_URL=http://localhost:3000

# --- App ---
API_SECRET_KEY=change-me-locally
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of origins the web app is served from. In
# production this must be the real frontend origin(s), not localhost.
CORS_ORIGINS=http://localhost:3000
