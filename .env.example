# Copy this file to .env and fill in real values. .env is gitignored.
# docker-compose and the apps both read from this file.

# --- Postgres ---
POSTGRES_USER=devatlas
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=devatlas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devatlas:change-me-locally@postgres:5432/devatlas

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Ollama (local LLM provider) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Embedding-capable model — a different model family from OLLAMA_MODEL
# above (see docs/architecture/rag-engine-v1.md). Changing this requires
# a migration + re-embedding every chunk if the new model's output
# dimension differs from schemas.EMBEDDING_DIMENSIONS (768).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- LLM Gateway ---
# "ollama" for local dev, "groq" to route generation through Groq's
# hosted API instead (get a key at https://console.groq.com/keys). Groq
# has no embeddings endpoint, so RAG search/ask still needs Ollama
# running for OLLAMA_EMBEDDING_MODEL regardless of this setting. The
# gateway is provider-swappable; a future "anthropic" provider can be
# added the same way without changing callers.
LLM_PROVIDER=ollama
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# --- Auth (GitHub OAuth + GitHub App) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Auth (email/password) ---
# All of these have working defaults (see app/core/config.py) — only set
# them here if you need to deviate. FRONTEND_URL is what password-reset
# and email-verification links point to.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# MAX_FAILED_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15
FRONTEND_URL=http://localhost:3000

# --- Auth: transactional email (apps/api/app/modules/auth/email.py) ---
# "console" (default) logs reset/verification links instead of sending
# them. Set to "resend" + RESEND_API_KEY in production to actually
# deliver mail — get a key at https://resend.com/api-keys.
# EMAIL_FROM_ADDRESS must be on a domain verified in the Resend
# dashboard once you're past their onboarding@resend.dev sandbox sender
# (which only delivers to the account owner's own inbox).
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM_ADDRESS=DevAtlas <noreply@yourdomain.com>

# --- Documentation Ingestion Engine: object storage (MinIO locally,
# real S3 in production — see docker-compose.yml's `minio`/`minio-init`
# services and docs/architecture/ingestion-engine-v1.md Section 8) ---
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=devatlas-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY_ID=devatlas-minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me-locally

# --- Documentation Ingestion Engine: limits ---
# All have working defaults (see apps/api/app/core/config.py and
# services/ingestion_worker/settings.py) — only set them here to deviate.
# MAX_ACTIVE_INGESTION_JOBS_PER_PROJECT=20
# INGESTION_MAX_UPLOAD_BYTES=26214400
# INGESTION_MAX_WEBSITE_PAGES=200
# INGESTION_MAX_WEBSITE_CRAWL_DEPTH=3
# INGESTION_MAX_GITHUB_FILES=500
# INGESTION_MAX_GITHUB_REPO_BYTES=209715200
# Optional — raises the GitHub API's unauthenticated 60 req/hour rate
# limit for repo-tree listing. Never required for public repos.
GITHUB_API_TOKEN=

# --- RAG Knowledge Engine (docs/architecture/rag-engine-v1.md) ---
# All have working defaults (see apps/api/app/core/config.py) — only set
# them here to deviate.
# RETRIEVAL_VECTOR_CANDIDATES=20
# RETRIEVAL_KEYWORD_CANDIDATES=20
# RETRIEVAL_TOP_K=8
# RETRIEVAL_RRF_K=60
# CONTEXT_MAX_TOKENS=3000
# RETRIEVAL_CACHE_TTL_SECONDS=300

# --- Taxonomy & Curriculum Engine (docs/architecture/curriculum-engine-v1.md) ---
# TAXONOMY_DATA_DIR must point at packages/taxonomy-data's in-container
# mount (see docker-compose.yml's `api` service), not the host-relative
# path apps/api/.env.example uses for running the API directly on the
# host.
TAXONOMY_DATA_DIR=/packages/taxonomy-data/concepts
# CURRICULUM_MINUTES_FOUNDATIONAL=30
# CURRICULUM_MINUTES_INTERMEDIATE=60
# CURRICULUM_MINUTES_ADVANCED=90

# --- Mentoring Engine (docs/architecture/mentor-engine-v1.md) ---
# MENTOR_RECENT_MESSAGE_LIMIT=20
# MENTOR_SUMMARY_TRIGGER_MESSAGES=20

# --- App ---
API_SECRET_KEY=change-me-locally
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of origins the web app is served from. In
# production this must be the real frontend origin(s), not localhost.
CORS_ORIGINS=http://localhost:3000

# --- Production overrides (docker-compose.prod.yml) ---
# Not used in dev. Required when running with
# `-f docker-compose.yml -f docker-compose.prod.yml`:
#   ENVIRONMENT=production            # gates docs_url, cookie Secure flag,
#                                      # JSON logs — see app/core/config.py
#   API_SECRET_KEY=<32+ random bytes>  # Settings rejects short keys in prod
#   OBJECT_STORAGE_BACKEND=s3          # real S3, not the local disk backend
#   CORS_ORIGINS=https://<web-domain>
#   API_DOMAIN=api.example.com         # infra/nginx/templates
#   WEB_DOMAIN=app.example.com         # infra/nginx/templates
#   CERTBOT_EMAIL=you@example.com      # Let's Encrypt renewal notices
# See docs/architecture/DEPLOYMENT.md for the full production checklist.
