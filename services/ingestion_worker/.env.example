# For running the worker directly on the host (uv run arq worker.WorkerSettings)
# instead of via docker-compose. Copy to services/ingestion_worker/.env.
# See apps/api/.env.example for why "localhost" is correct here but not
# inside Docker Compose.

DATABASE_URL=postgresql+asyncpg://devatlas:change-me-locally@localhost:5432/devatlas
REDIS_URL=redis://localhost:6379/0

# --- Documentation Ingestion Engine ---
# Same backend selection as apps/api/.env.example — "local" needs no
# MinIO/S3 for host-only dev; switch to "s3" +
# OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000 if docker-compose's
# `minio` service is running alongside a host-run worker.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=./.data/object_storage
# GITHUB_API_TOKEN=

# --- RAG Knowledge Engine embedding (docs/architecture/rag-engine-v1.md) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
