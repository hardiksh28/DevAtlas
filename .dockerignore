# Root build context is shared by apps/web/Dockerfile (pnpm workspace),
# apps/api/Dockerfile, and services/ingestion_worker/Dockerfile (both need
# the uv workspace root to resolve packages/schemas + packages/object_storage).
.git
.venv
node_modules
**/node_modules
**/.next
**/__pycache__
**/*.pyc
.env
.env.*
!.env.example
*.log
.DS_Store
docs

# Never read by any Dockerfile in this repo — apps/web's pnpm workspace
# only touches apps/web and packages/ui.
packages/taxonomy-data
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
